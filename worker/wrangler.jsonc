// The live board collector: a Cloudflare Worker with a D1 database.
// Deploy from this folder with `npx wrangler deploy`. The two secrets
// (EXPORT_TOKEN, IP_SALT) are set with `npx wrangler secret put`, never here.
{
  "name": "tartarus-live",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tartarus-live",
      "database_id": "cd66b631-39c6-44b6-92e3-bcafd87c76e0"
    }
  ],
  // Per address: at most 60 uploads a minute (each carries up to 10 boards).
  "ratelimits": [
    {
      "name": "LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
